# Local restart database. Create it separately before running the application.
DB_URL=jdbc:postgresql://localhost:5433/queuenotify_restart
DB_USERNAME=postgres
DB_PASSWORD=postgres
PORT=8080

# Maven does not load this file automatically; export variables before running.
# Actual delivery will require real VAPID keys and the sender implementation.
NOTIFICATION_MODE=console
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
